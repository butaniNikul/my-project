   "source": [
    "# text to speech "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pyttsx3\n",
    "\n",
    "data = input(\"enter text wich you want to covert to speech:\\n\")\n",
    "\n",
    "engine = pyttsx3.init()\n",
    "engine.say(data)\n",
    "engine.runAndWait()\n"
   ]
